# 기본: Git이 텍스트/바이너리 자동 판별
* text=auto

# 소스 코드 — 저장소·작업 복사본 모두 LF
*.php   text eol=lf
*.js    text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.htm   text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.md    text eol=lf
*.mdc   text eol=lf
*.sql   text eol=lf
*.py    text eol=lf
*.sh    text eol=lf
*.xml   text eol=lf
*.txt   text eol=lf

# Windows 전용 스크립트 — CRLF 유지
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# 바이너리 — 줄바꿈 변환 금지
*.jpg   -text
*.jpeg  -text
*.png   -text
*.gif   -text
*.webp  -text
*.ico   -text
*.pdf   -text
*.woff  -text
*.woff2 -text
*.ttf   -text
*.eot   -text
*.swf   -text
*.zip   -text
